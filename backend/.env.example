# Copy to .env and fill in. NEVER commit the real .env file.
ENV=development                      # development | production | test
DATABASE_URL=postgresql+psycopg2://squiz:CHANGE_ME@localhost:5432/squiz
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"  (must be >= 32 chars)
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Comma-separated origins allowed by CORS (admin web UI is same-origin and needs none).
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=2
RATE_LIMIT_ENABLED=true
# Only read by `python -m app.cli create-admin` (prompted for the password if not set):
ADMIN_FULL_NAME=
ADMIN_PHONE=
ADMIN_PASSWORD=
